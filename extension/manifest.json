{
  "manifest_version": 3,
  "name": "TribalSaarthi Guide (prototype)",
  "version": "0.11.2",
  "description": "Scholarship guide for MahaDBT, NSP and the Ministry of Tribal Affairs: explains pages and helps check forms and documents.",
  "permissions": ["sidePanel", "storage", "scripting"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "host_permissions": ["https://mahadbt.maharashtra.gov.in/*", "https://mahadbt2.maharashtra.gov.in/*", "https://scholarships.gov.in/*", "https://tribal.nic.in/*", "http://localhost:4501/*", "https://tribalsaarthi.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open TribalSaarthi guide" },
  "content_scripts": [
    {
      "matches": ["https://mahadbt.maharashtra.gov.in/*", "https://mahadbt2.maharashtra.gov.in/*", "https://scholarships.gov.in/*", "https://tribal.nic.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:4500/*", "http://localhost:5173/*", "https://tribalsaarthi.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
