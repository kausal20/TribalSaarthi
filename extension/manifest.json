{
  "manifest_version": 3,
  "name": "TribalSaarthi Guide (prototype)",
  "version": "0.6.0",
  "description": "Prototype guide for MahaDBT and the National Scholarship Portal: explains pages and checks forms and documents on your device.",
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["https://mahadbt.maharashtra.gov.in/*", "https://scholarships.gov.in/*", "http://localhost:4501/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open TribalSaarthi guide" },
  "content_scripts": [
    {
      "matches": ["https://mahadbt.maharashtra.gov.in/*", "https://scholarships.gov.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:4500/*", "http://localhost:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
