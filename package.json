{
  "name": "schemepath-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:extension": "vite build --config extension/vite.config.js && vite build --config extension/vite.pdf.config.js",
    "preview": "vite preview",
    "server": "node --dns-result-order=ipv4first --env-file=.env server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:guide": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "framer-motion": "^13.4.6",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
